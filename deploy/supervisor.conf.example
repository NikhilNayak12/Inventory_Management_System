[program:inventory-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/Inventory_Management_System/artisan queue:work --sleep=3 --tries=3 --timeout=90
autostart=true
autorestart=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/Inventory_Management_System/storage/logs/queue-worker.log